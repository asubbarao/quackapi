from .{{ op }}_dto import {{ row_class }}

HERE = Path(__file__).parent
SOURCES = [HERE / "setup.sql", HERE / "{{ op }}.sql"]
_RESPONSE = TypeAdapter({{ response_type }})
router = APIRouter()


@router.{{ method }}("{{ path }}", operation_id="{{ op }}")
def {{ op }}({{ params }}) -> {{ response_type }}:
    values = { {{ param_values }} }
