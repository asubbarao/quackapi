# The nested dollar-quoted body, newlines and all, comes back verbatim.
query I
SELECT contains(getvariable('got'), $orig$$copy$
COPY (SELECT $profile${{ profile_text }}$profile$) TO {{ target }} (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');
$copy$$orig$);
----
true

# ── token forms ────────────────────────────────────────────────────────────

# Quoted identifiers, '' inside a literal, E'' escapes, a /* */ comment, casts, a list subscript, a $1-style parameter
# and an exec-route parameter keep their meaning.
statement ok
CREATE OR REPLACE ROUTE forms GET '/forms' AS SELECT "odd name"."col x" AS "a b", 'it''s' AS q, E'tab\there' AS e, /* note */ [1, 2, 3][2] AS i, 1.5e3::INTEGER AS n, -1 AS neg FROM (SELECT 1 AS "col x") "odd name";

statement ok
SET VARIABLE got = (SELECT handler FROM quackapi_routes() WHERE name = 'forms');

query II
FROM tree_diff($orig$SELECT "odd name"."col x" AS "a b", 'it''s' AS q, E'tab\there' AS e, /* note */ [1, 2, 3][2] AS i, 1.5e3::INTEGER AS n, -1 AS neg FROM (SELECT 1 AS "col x") "odd name"$orig$, getvariable('got'));
----
0	false

statement ok
CREATE OR REPLACE ROUTE exec POST '/exec' AS $sql;

query I
SELECT handler FROM quackapi_routes() WHERE name = 'exec';
----
$sql

# A statement ends at its own ';': the next one runs as ordinary SQL.
statement ok
CREATE OR REPLACE ROUTE first GET '/first' AS SELECT ';' AS semi; CREATE OR REPLACE ROUTE second GET '/second' AS SELECT 2 AS two;

query II
SELECT name, handler FROM quackapi_routes() WHERE name IN ('first', 'second') ORDER BY name;
----
first	SELECT ';' AS semi
second	SELECT 2 AS two

# Two adjacent string literals concatenate only across a newline, which the token view does not carry: refused, not
# guessed.
statement error
CREATE OR REPLACE ROUTE adjacent GET '/adjacent' AS SELECT 'a'
'b' AS ab;
----
cannot rebuild adjacent string literals

statement ok
DROP ROUTE first;

query I
SELECT count(*) FROM quackapi_routes() WHERE name = 'first';
----
0
