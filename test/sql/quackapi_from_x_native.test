# name: test/sql/quackapi_from_x_native.test
# description: Framework-selectable route and model importers
# group: [sql]

require quackapi

# ---------------------------------------------------------------------------
# FastAPI — routes from committed fastapi_mini fixture (2 routes)
# ---------------------------------------------------------------------------
query III
SELECT method, path, handler_name
FROM quack_from_routes('fastapi', 'bridges/from_x/fixtures/fastapi_mini')
ORDER BY method, path;
----
GET	/articles/{slug}	get_article
POST	/login	login

# ---------------------------------------------------------------------------
# FastAPI — models: UserInLogin with 3 fields (2 required, 1 defaulted)
# ---------------------------------------------------------------------------
query IIIII
SELECT model_name, field_name, field_type, is_required, has_default
FROM quack_from_models('fastapi', 'bridges/from_x/fixtures/fastapi_mini')
ORDER BY field_line, field_name;
----
UserInLogin	email	str	true	false
UserInLogin	password	str	true	false
UserInLogin	remember_me	bool	false	true

query I
SELECT default_expr FROM quack_from_models('fastapi', 'bridges/from_x/fixtures/fastapi_mini')
WHERE field_name = 'remember_me';
----
False

# ---------------------------------------------------------------------------
# Rails — routes from committed rails_mini fixture (2 routes under /api)
# ---------------------------------------------------------------------------
query III
SELECT method, path, handler_name
FROM quack_from_routes('rails', 'bridges/from_x/fixtures/rails_mini')
ORDER BY method, path;
----
GET	/api/articles/:slug	articles#show
POST	/api/login	sessions#create

# ---------------------------------------------------------------------------
# Rails — models: User validates (2 presence-required, 1 optional)
# ---------------------------------------------------------------------------
query IIIII
SELECT model_name, field_name, field_type, is_required, has_default
FROM quack_from_models('rails', 'bridges/from_x/fixtures/rails_mini')
ORDER BY field_name;
----
User	email	presence	true	false
User	password	presence	true	false
User	remember_me	allow_blank,inclusion	false	false

# ---------------------------------------------------------------------------
# Express — routes from committed express_mini fixture (2 routes)
# ---------------------------------------------------------------------------
query III
SELECT method, path, handler_name
FROM quack_from_routes('express', 'bridges/from_x/fixtures/express_mini')
ORDER BY method, path;
----
GET	/articles/:slug	getArticle
POST	/login	login

# ---------------------------------------------------------------------------
# Express — models: UserInLogin class (2 required, 1 defaulted)
# ---------------------------------------------------------------------------
query IIIII
SELECT model_name, field_name, field_type, is_required, has_default
FROM quack_from_models('express', 'bridges/from_x/fixtures/express_mini')
ORDER BY field_line, field_name;
----
UserInLogin	email	string	true	false
UserInLogin	password	string	true	false
UserInLogin	remember_me	boolean	false	true

query I
SELECT default_expr FROM quack_from_models('express', 'bridges/from_x/fixtures/express_mini')
WHERE field_name = 'remember_me';
----
false

# ---------------------------------------------------------------------------
# Gin — routes from committed gin_mini fixture (2 routes under /api)
# ---------------------------------------------------------------------------
query III
SELECT method, path, handler_name
FROM quack_from_routes('gin', 'bridges/from_x/fixtures/gin_mini')
ORDER BY method, path;
----
GET	/api/articles/:slug	GetArticle
POST	/api/login	Login

# ---------------------------------------------------------------------------
# Gin — models: UserInLogin struct tags (2 required, 1 omitempty optional)
# ---------------------------------------------------------------------------
query IIIII
SELECT model_name, field_name, field_type, is_required, has_default
FROM quack_from_models('gin', 'bridges/from_x/fixtures/gin_mini')
ORDER BY field_line, field_name;
----
UserInLogin	Email	string	true	false
UserInLogin	Password	string	true	false
UserInLogin	RememberMe	bool	false	false

# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Argument validation happens during binding, before sitting_duck bootstrap.
# ---------------------------------------------------------------------------
statement error
SELECT * FROM quack_from_routes(NULL, 'bridges/from_x/fixtures/fastapi_mini');
----
framework and path must not be NULL

statement error
SELECT * FROM quack_from_models('unknown', 'bridges/from_x/fixtures/fastapi_mini');
----
unknown framework

statement error
SELECT * FROM quack_from_routes('fastapi', NULL);
----
framework and path must not be NULL

statement error
SELECT * FROM quack_from_models('fastapi', '');
----
path must be non-empty

statement error
SELECT * FROM quack_from_fastapi('bridges/from_x/fixtures/fastapi_mini');
----
does not exist

statement error
SELECT quack_from_x_sql('fastapi', 'routes');
----
does not exist

statement error
SELECT quack_from_x_sql_relpath('fastapi', 'routes');
----
does not exist
