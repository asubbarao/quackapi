# name: test/sql/quackapi_db_release.test
# description: Handler connections must not keep the database alive after the request
# group: [sql]

require quackapi

statement ok
CREATE ROUTE qa_release GET '/qa_release' AS SELECT 1 AS v;

query I
SELECT * FROM quackapi_serve(29481, host := '127.0.0.1', access_log := false);
----
http://127.0.0.1:29481

# Served over TCP on an httplib worker thread.
query I
SELECT (quackapi_fetch('http://127.0.0.1:29481/qa_release')).status;
----
200

# Served in-process on whichever DuckDB thread runs the scan.
query I
SELECT status FROM quackapi_request('GET', '/qa_release');
----
200

# Dropping the last user reference destroys the database, which stops its
# server. A connection still held by a handler thread would keep it listening.
restart

query I
SELECT ready FROM quackapi_wait(29481, 200);
----
false
