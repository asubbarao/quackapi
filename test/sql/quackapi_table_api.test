# name: test/sql/quackapi_table_api.test
# description: CREATE API FOR TABLE generated routes answer over HTTP via quackapi_request
# group: [sql]

require quackapi

statement ok
CREATE TABLE cases AS
  SELECT 1 AS id, '24-000117' AS case_no
  UNION ALL
  SELECT 2, '24-000118';

# Generates list + by-key routes; exercise them over the request path.
statement ok
CREATE API FOR TABLE cases;

query II
SELECT status, decode(body) FROM quackapi_request('GET', '/cases');
----
200	[{"id":1,"case_no":"24-000117"},{"id":2,"case_no":"24-000118"}]

query II
SELECT status, decode(body) FROM quackapi_request('GET', '/cases/1');
----
200	[{"id":1,"case_no":"24-000117"}]

query II
SELECT status, decode(body) FROM quackapi_request('GET', '/cases/999');
----
200	[]

# Custom base path and key column — HTTP hit
statement ok
CREATE TABLE documents AS SELECT 1 AS doc_id, 'report.pdf' AS filename;

statement ok
CREATE API FOR TABLE documents AT '/api/documents' KEY 'doc_id';

query II
SELECT status, decode(body) FROM quackapi_request('GET', '/api/documents/1');
----
200	[{"doc_id":1,"filename":"report.pdf"}]

query II
SELECT status, decode(body) FROM quackapi_request('GET', '/api/documents');
----
200	[{"doc_id":1,"filename":"report.pdf"}]

# DROP ROUTE removes a generated route (404 after)
statement ok
DROP ROUTE cases_list;

query I
SELECT status FROM quackapi_request('GET', '/cases');
----
404

# OR REPLACE re-generates without a duplicate error.
statement ok
CREATE OR REPLACE API FOR TABLE documents AT '/api/documents' KEY 'doc_id';

query I
SELECT status FROM quackapi_request('GET', '/api/documents/1');
----
200

# Bad grammar: AT requires a leading-slash quoted path.
statement error
CREATE API FOR TABLE cases AT 'nope';
----

# Quoted table identifier with embedded double-quote — QuoteIdent must not break out.
statement ok
CREATE TABLE "weird""name" AS SELECT 1 AS id, 'v' AS v;

statement ok
CREATE API FOR TABLE "weird""name" KEY 'id';

query II
SELECT status, decode(body) FROM quackapi_request('GET', '/weird"name');
----
200	[{"id":1,"v":"v"}]

query II
SELECT status, decode(body) FROM quackapi_request('GET', '/weird"name/1');
----
200	[{"id":1,"v":"v"}]

# Bare table token with an embedded " is rejected (use "quoted""ident" form).
statement error
CREATE API FOR TABLE bare"quote;
----
invalid table name

# KEY must be a safe path-param identifier.
statement error
CREATE API FOR TABLE cases KEY 'id"x';
----
KEY must be a bare identifier
