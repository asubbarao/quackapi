# name: test/sql/quackapi_http_pool_bounds.test
# description: One-off origins cannot grow the idle host registry without bound
# group: [sql]

require quackapi

statement ok
SELECT sum(length((quackapi_post('http://127.0.0.1:' || (33000 + i)::VARCHAR || '/', '')).error)) FROM range(270) t(i);

query I
SELECT count(*) <= 256 FROM quackapi_http_pool();
----
true

query I
SELECT coalesce(sum(idle), 0) <= 256 FROM quackapi_http_pool();
----
true
