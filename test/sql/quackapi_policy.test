# name: test/sql/quackapi_policy.test
# description: ROW ACCESS / MASKING enforcement via quackapi_request (claims-keyed)
# group: [sql]

require quackapi

require json

# JWTs in test/sql/fixtures/jwt_pol_*.txt — SECRET 'policy-test-secret' (HS256).
# Loaded via SET VARIABLE so signature bytes that contain '--' are not SQL comments.
# require json: JWT claims parse uses json_* inside quackapi_verify_auth.

# ---------------------------------------------------------------------------
# DDL setup — policies, binds, seed, routes
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE policy_orders (id INTEGER, tenant_id VARCHAR, amount INTEGER);

statement ok
CREATE TABLE policy_users (id INTEGER, email VARCHAR, tenant_id VARCHAR);

statement ok
INSERT INTO policy_orders VALUES
  (1, 'acme', 100),
  (2, 'beta', 200),
  (3, 'acme', 150);

statement ok
INSERT INTO policy_users VALUES
  (1, 'alice@acme.test', 'acme'),
  (2, 'bob@beta.test', 'beta');

query I
CREATE AUTH jwt_pol AS JWT ( SECRET 'policy-test-secret' );
----
Auth jwt_pol: JWT_HS256

query I
CREATE ROW ACCESS POLICY tenant_isolation
  AS (tenant_id VARCHAR) RETURNS BOOLEAN
  USING (tenant_id = $claims_tenant OR $claims_role = 'admin');
----
Row access policy tenant_isolation

query I
CREATE MASKING POLICY mask_email ON VARCHAR
  USING (CASE WHEN $claims_role = 'admin' THEN val ELSE '***' END);
----
Masking policy mask_email ON VARCHAR

# Duplicate without OR REPLACE errors
statement error
CREATE ROW ACCESS POLICY tenant_isolation
  AS (tenant_id VARCHAR) RETURNS BOOLEAN
  USING (true);
----
already exists

# Name collision across kinds errors
statement error
CREATE MASKING POLICY tenant_isolation ON VARCHAR USING (val);
----
already used by a row access policy

query I
ALTER TABLE policy_orders ADD ROW ACCESS POLICY tenant_isolation ON (tenant_id);
----
Bound row access policy tenant_isolation on policy_orders

query I
ALTER TABLE policy_users ADD ROW ACCESS POLICY tenant_isolation ON (tenant_id);
----
Bound row access policy tenant_isolation on policy_users

query I
ALTER TABLE policy_users MODIFY COLUMN email SET MASKING POLICY mask_email;
----
Set masking policy mask_email on policy_users.email

query I
CREATE ROUTE list_orders GET '/orders' REQUIRE jwt_pol AS
  SELECT id, tenant_id, amount FROM policy_orders ORDER BY id;
----
Route list_orders: GET /orders

query I
CREATE ROUTE list_users GET '/users' REQUIRE jwt_pol AS
  SELECT id, email, tenant_id FROM policy_users ORDER BY id;
----
Route list_users: GET /users

# Public route on policied table — CREATE ok; request must fail closed (403)
query I
CREATE ROUTE public_orders GET '/public_orders' AS
  SELECT id, tenant_id FROM policy_orders;
----
Route public_orders: GET /public_orders

# Parsed policy enforcement covers schema-qualified base tables. Views and
# table macros are deliberately rejected while a bound expansion is unavailable,
# rather than leaking their protected dependencies.
statement ok
CREATE VIEW policy_orders_view AS SELECT * FROM policy_orders;

statement ok
CREATE MACRO policy_orders_macro() AS TABLE SELECT * FROM policy_orders;

query I
CREATE ROUTE list_orders_qualified GET '/orders-qualified' REQUIRE jwt_pol AS
  SELECT id, tenant_id, amount FROM main.policy_orders ORDER BY id;
----
Route list_orders_qualified: GET /orders-qualified

query I
CREATE ROUTE public_orders_view GET '/public_orders_view' AS
  SELECT id, tenant_id FROM policy_orders_view;
----
Route public_orders_view: GET /public_orders_view

query I
CREATE ROUTE public_orders_macro GET '/public_orders_macro' AS
  SELECT id, tenant_id FROM policy_orders_macro();
----
Route public_orders_macro: GET /public_orders_macro

# Nested scalar expressions and CTEs must be walked by the policy rewriter;
# a relation hidden outside the top-level FROM is not a safe bypass. The CTE
# deliberately shadows the bound table name while its body uses a qualified
# alias for the actual catalog table.
query I
CREATE ROUTE public_users_scalar GET '/public_users_scalar' AS
  SELECT (SELECT email FROM policy_users ORDER BY id LIMIT 1) AS email;
----
Route public_users_scalar: GET /public_users_scalar

query I
CREATE ROUTE list_users_scalar GET '/users-scalar' REQUIRE jwt_pol AS
  SELECT (SELECT email FROM policy_users WHERE tenant_id = $claims_tenant ORDER BY id LIMIT 1) AS email;
----
Route list_users_scalar: GET /users-scalar

query I
CREATE ROUTE list_users_cte GET '/users-cte' REQUIRE jwt_pol AS
  WITH policy_users AS (
    SELECT p.id, p.email, p.tenant_id FROM main.policy_users AS p
  )
  SELECT u.email FROM policy_users AS u ORDER BY u.id;
----
Route list_users_cte: GET /users-cte

# Table macros remain an indirect relation source for all callers until a
# bound expansion exists; authenticated credentials do not make it safe.
query I
CREATE ROUTE auth_orders_macro GET '/auth_orders_macro' REQUIRE jwt_pol AS
  SELECT id, tenant_id FROM policy_orders_macro();
----
Route auth_orders_macro: GET /auth_orders_macro

# Policy enforcement is read-only today. Reject protected-table mutations
# rather than executing an update without a row-level write policy.
query I
CREATE ROUTE mutate_orders POST '/mutate_orders' REQUIRE jwt_pol AS
  UPDATE policy_orders SET amount = 0 WHERE id = 1 RETURNING id;
----
Route mutate_orders: POST /mutate_orders

query I
CREATE STREAM policy_orders_sse GET '/policy-orders-sse' AS
  SELECT id, tenant_id FROM policy_orders;
----
Stream policy_orders_sse: GET /policy-orders-sse SSE

query I
CREATE GRAPHQL ROUTE policy_orders_gql POST '/orders-gql' FROM policy_orders REQUIRE jwt_pol;
----
GraphQL route policy_orders_gql: POST /orders-gql FROM policy_orders REQUIRE jwt_pol LIMIT 100

query I
CREATE GRAPHQL ROUTE policy_users_gql POST '/users-gql' FROM policy_users REQUIRE jwt_pol;
----
GraphQL route policy_users_gql: POST /users-gql FROM policy_users REQUIRE jwt_pol LIMIT 100

# This registration must never turn a policy-protected table into a public
# built-in GraphQL endpoint.
query I
CREATE GRAPHQL FOR TABLE policy_orders;
----
GraphQL registered: policy_orders (allowlist mode on POST /graphql)

statement ok
SET VARIABLE jwt_acme_user = (
  SELECT rtrim(content, E'\n\r ') FROM read_text('test/sql/fixtures/jwt_pol_acme_user.txt')
);

statement ok
SET VARIABLE jwt_acme_admin = (
  SELECT rtrim(content, E'\n\r ') FROM read_text('test/sql/fixtures/jwt_pol_acme_admin.txt')
);

statement ok
SET VARIABLE jwt_beta_user = (
  SELECT rtrim(content, E'\n\r ') FROM read_text('test/sql/fixtures/jwt_pol_beta_user.txt')
);

# ---------------------------------------------------------------------------
# Row access policy — filters rows by claim (via quackapi_request)
# ---------------------------------------------------------------------------
# acme user → only acme rows
query II
SELECT status, decode(body)
FROM quackapi_request(
  'GET', '/orders',
  headers := MAP {'Authorization': 'Bearer ' || getvariable('jwt_acme_user')}
);
----
200	[{"id":1,"tenant_id":"acme","amount":100},{"id":3,"tenant_id":"acme","amount":150}]

# beta user → only beta rows
query II
SELECT status, decode(body)
FROM quackapi_request(
  'GET', '/orders',
  headers := MAP {'Authorization': 'Bearer ' || getvariable('jwt_beta_user')}
);
----
200	[{"id":2,"tenant_id":"beta","amount":200}]

# admin → all tenants
query II
SELECT status, decode(body)
FROM quackapi_request(
  'GET', '/orders',
  headers := MAP {'Authorization': 'Bearer ' || getvariable('jwt_acme_admin')}
);
----
200	[{"id":1,"tenant_id":"acme","amount":100},{"id":2,"tenant_id":"beta","amount":200},{"id":3,"tenant_id":"acme","amount":150}]

# A qualified direct table reference is rewritten from the parsed base-table
# identity, not a bare-name text match.
query II
SELECT status, decode(body)
FROM quackapi_request(
  'GET', '/orders-qualified',
  headers := MAP {'Authorization': 'Bearer ' || getvariable('jwt_acme_user')}
);
----
200	[{"id":1,"tenant_id":"acme","amount":100},{"id":3,"tenant_id":"acme","amount":150}]

# ---------------------------------------------------------------------------
# Masking policy — column masked unless claims permit
# ---------------------------------------------------------------------------
# acme user → email masked; RAP also limits to acme row
query II
SELECT status, decode(body)
FROM quackapi_request(
  'GET', '/users',
  headers := MAP {'Authorization': 'Bearer ' || getvariable('jwt_acme_user')}
);
----
200	[{"id":1,"email":"***","tenant_id":"acme"}]

# admin → email unmasked; sees all tenants
query II
SELECT status, decode(body)
FROM quackapi_request(
  'GET', '/users',
  headers := MAP {'Authorization': 'Bearer ' || getvariable('jwt_acme_admin')}
);
----
200	[{"id":1,"email":"alice@acme.test","tenant_id":"acme"},{"id":2,"email":"bob@beta.test","tenant_id":"beta"}]

# Scalar subqueries and CTE bodies are parsed and rewritten recursively. The
# first verifies authenticated RAP/masking; the second verifies a public
# scalar source fails closed rather than reading the underlying table.
query II
SELECT status, decode(body)
FROM quackapi_request(
  'GET', '/users-scalar',
  headers := MAP {'Authorization': 'Bearer ' || getvariable('jwt_acme_user')}
);
----
200	[{"email":"***"}]

query II
SELECT status, decode(body)
FROM quackapi_request(
  'GET', '/users-cte',
  headers := MAP {'Authorization': 'Bearer ' || getvariable('jwt_acme_user')}
);
----
200	[{"email":"***"}]

query II
SELECT status, decode(body) FROM quackapi_request('GET', '/public_users_scalar');
----
403	{"detail":"Policy denies unauthenticated access"}

# Indirect table macros and protected-table writes are denied even after JWT
# verification. Confirm the rejected mutation left the table unchanged.
query II
SELECT status, decode(body)
FROM quackapi_request(
  'GET', '/auth_orders_macro',
  headers := MAP {'Authorization': 'Bearer ' || getvariable('jwt_acme_user')}
);
----
403	{"detail":"Policy denies unauthenticated access"}

query II
SELECT status, decode(body)
FROM quackapi_request(
  'POST', '/mutate_orders',
  headers := MAP {'Authorization': 'Bearer ' || getvariable('jwt_acme_user')}
);
----
403	{"detail":"Policy denies unauthenticated access"}

query I
SELECT amount FROM policy_orders WHERE id = 1;
----
100

# ---------------------------------------------------------------------------
# Fail closed — unauthenticated request to policied table → 403 (not open)
# ---------------------------------------------------------------------------
query II
SELECT status, decode(body) FROM quackapi_request('GET', '/public_orders');
----
403	{"detail":"Policy denies unauthenticated access"}

# Views and table macros are indirect sources. They fail closed instead of
# bypassing a policy bound to policy_orders.
query II
SELECT status, decode(body) FROM quackapi_request('GET', '/public_orders_view');
----
403	{"detail":"Policy denies unauthenticated access"}

query II
SELECT status, decode(body) FROM quackapi_request('GET', '/public_orders_macro');
----
403	{"detail":"Policy denies unauthenticated access"}

# Streams have no auth/claims contract yet, so a protected source must not
# become an unauthenticated SSE bypass.
query I
SELECT status FROM quackapi_request('GET', '/policy-orders-sse');
----
403

# REQUIRE without credentials still 401 (auth before policy)
query II
SELECT status, decode(body) FROM quackapi_request('GET', '/orders');
----
401	{"detail":"Not authenticated"}

# Named GraphQL applies the same RAP/masking expansion and verified claims as
# REST. Built-in GraphQL remains unauthenticated and therefore cannot read a
# registered protected table.
query II
SELECT status, decode(body) FROM quackapi_request(
  'POST', '/orders-gql',
  '{"query":"{ policy_orders { id tenant_id amount } }"}',
  headers := MAP {'Authorization': 'Bearer ' || getvariable('jwt_acme_user')}
);
----
200	{"data":{"policy_orders":[{"id":1,"tenant_id":"acme","amount":100},{"id":3,"tenant_id":"acme","amount":150}]}}

query II
SELECT status, decode(body) FROM quackapi_request(
  'POST', '/users-gql',
  '{"query":"{ policy_users { id email tenant_id } }"}',
  headers := MAP {'Authorization': 'Bearer ' || getvariable('jwt_acme_user')}
);
----
200	{"data":{"policy_users":[{"id":1,"email":"***","tenant_id":"acme"}]}}

query I
SELECT status FROM quackapi_request(
  'POST', '/orders-gql',
  '{"query":"{ policy_orders { id } }"}'
);
----
401

query II
SELECT status, decode(body) FROM quackapi_request(
  'POST', '/graphql',
  '{"query":"{ policy_orders { id } }"}'
);
----
200	{"errors":[{"message":"access denied by table policy"}]}

# Schema discovery uses the same named-route auth gate and does not expose a
# registered protected table through the unauthenticated built-in schema.
query I
SELECT status FROM quackapi_request('GET', '/orders-gql/schema');
----
401

query I
SELECT status FROM quackapi_request(
  'GET', '/orders-gql/schema',
  headers := MAP {'Authorization': 'Bearer ' || getvariable('jwt_acme_user')}
);
----
200

query II
SELECT status, contains(decode(body), 'policy_orders')
FROM quackapi_request('GET', '/graphql/schema');
----
200	false

# ---------------------------------------------------------------------------
# Bad grammar / missing policy
# ---------------------------------------------------------------------------
statement error
CREATE ROW ACCESS POLICY bad AS (x) USING (true);
----
RETURNS BOOLEAN

statement error
CREATE MASKING POLICY bad ON VARCHAR AS (val);
----
USING

statement error
ALTER TABLE policy_orders ADD ROW ACCESS POLICY nope ON (tenant_id);
----
does not exist

