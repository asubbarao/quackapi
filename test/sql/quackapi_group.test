# name: test/sql/quackapi_group.test
# description: CREATE GROUP — prefix join + auth inheritance via quackapi_request
# group: [sql]

require quackapi

require json

# ---------------------------------------------------------------------------
# Setup: two API_KEY schemes, one group with prefix + default auth
# ---------------------------------------------------------------------------
statement ok
CREATE AUTH api AS API_KEY;

statement ok
CREATE AUTH other AS API_KEY ( HEADER 'X-Other-Key' );

statement ok
SELECT * FROM quackapi_add_api_key('api', 'group-api-key', 'group-user');

statement ok
SELECT * FROM quackapi_add_api_key('other', 'route-other-key', 'other-user');

statement ok
CREATE GROUP v1 WITH (prefix='/api/v1', auth=api);

# Scheduling belongs to routes, not groups.
statement error
CREATE GROUP scheduled WITH (prefix='/scheduled', schedule='*/5 * * * * *');
----
Unknown GROUP option

# A grouped route may own a schedule after its prefix is expanded.
query I
CREATE ROUTE scheduled_group GET '/scheduled' GROUP v1 SCHEDULE '*/5 * * * * *' AS SELECT 'ok' AS msg;
----
Route scheduled_group: GET /api/v1/scheduled

query II
SELECT pattern, schedule FROM quackapi_routes() WHERE name = 'scheduled_group';
----
/api/v1/scheduled	*/5 * * * * *

query I
DROP ROUTE scheduled_group;
----
Dropped route scheduled_group

# Member with no REQUIRE — inherits group auth; path joins prefix
statement ok
CREATE ROUTE items_list GET '/items' GROUP v1 AS
  SELECT 1 AS id, 'x' AS name;

# Member with its own REQUIRE — overrides group auth
statement ok
CREATE ROUTE admin GET '/admin' GROUP v1 REQUIRE other AS
  SELECT $claims_sub AS user;

# ---------------------------------------------------------------------------
# Joined prefix path answers; bare member path does not
# ---------------------------------------------------------------------------
query II
SELECT status, decode(body)
FROM quackapi_request(
  'GET', '/api/v1/items',
  headers := MAP {'X-API-Key': 'group-api-key'}
);
----
200	[{"id":1,"name":"x"}]

query I
SELECT status FROM quackapi_request('GET', '/items');
----
404

# ---------------------------------------------------------------------------
# Group auth enforced on member that declares none
# ---------------------------------------------------------------------------
query II
SELECT status, decode(body) FROM quackapi_request('GET', '/api/v1/items');
----
401	{"detail":"Not authenticated"}

query II
SELECT status, decode(body)
FROM quackapi_request(
  'GET', '/api/v1/items',
  headers := MAP {'X-API-Key': 'wrong-key'}
);
----
401	{"detail":"Invalid authentication credentials"}

query II
SELECT status, decode(body)
FROM quackapi_request(
  'GET', '/api/v1/items',
  headers := MAP {'X-API-Key': 'group-api-key'}
);
----
200	[{"id":1,"name":"x"}]

# ---------------------------------------------------------------------------
# Member route REQUIRE overrides group auth
# ---------------------------------------------------------------------------
# Group key is not enough for the overriding scheme
query II
SELECT status, decode(body)
FROM quackapi_request(
  'GET', '/api/v1/admin',
  headers := MAP {'X-API-Key': 'group-api-key'}
);
----
401	{"detail":"Not authenticated"}

# Correct other-scheme key succeeds; claims come from other auth
query II
SELECT status, decode(body)
FROM quackapi_request(
  'GET', '/api/v1/admin',
  headers := MAP {'X-Other-Key': 'route-other-key'}
);
----
200	[{"user":"other-user"}]

# No credentials → 401
query I
SELECT status FROM quackapi_request('GET', '/api/v1/admin');
----
401
