# name: test/sql/quackapi_route_timeout.test
# description: Per-route TIMEOUT / WITH (timeout_sec) extends httplib IO deadlines
# group: [sql]

require quackapi

require json

# Community http_client is the TCP client for the served requests below.
statement ok
INSTALL http_client FROM community;

statement ok
LOAD http_client;

# --- DDL: TIMEOUT clause + WITH (timeout_sec) land on the registry ------------
query I
CREATE ROUTE slow_clause GET '/slow-clause' TIMEOUT 180 AS SELECT 1 AS n;
----
Route slow_clause: GET /slow-clause

query I
SELECT timeout_sec FROM quackapi_routes() WHERE name = 'slow_clause';
----
180

query I
CREATE OR REPLACE ROUTE slow_with GET '/slow-with'
  WITH (timeout_sec := 90)
  AS SELECT 1 AS n;
----
Route slow_with: GET /slow-with

query I
SELECT timeout_sec FROM quackapi_routes() WHERE name = 'slow_with';
----
90

query I
CREATE OR REPLACE ROUTE slow_dur GET '/slow-dur' TIMEOUT '3m' AS SELECT 1 AS n;
----
Route slow_dur: GET /slow-dur

query I
SELECT timeout_sec FROM quackapi_routes() WHERE name = 'slow_dur';
----
180

# Default remains 0 (serve-level 30s IO timeouts apply).
query I
CREATE ROUTE fast GET '/fast' AS SELECT 'ok' AS msg;
----
Route fast: GET /fast

query I
SELECT timeout_sec FROM quackapi_routes() WHERE name = 'fast';
----
0

statement error
CREATE ROUTE bad GET '/bad' TIMEOUT 0 AS SELECT 1;
----
timeout must be a positive

statement error
CREATE ROUTE bad2 GET '/bad2' WITH (timeout_sec := 180, response := 'json') AS SELECT 1;
----
Unknown WITH option

# --- Effective write deadline (all platforms) --------------------------------
# Prove ApplyRouteIoTimeout ran (or did not) via quackapi_last_write_timeout_sec,
# which records what the apply path actually did — not the registry timeout_sec.

statement ok
CREATE OR REPLACE ROUTE probe_default GET '/probe-default' AS SELECT 1 AS n;

statement ok
CREATE OR REPLACE ROUTE probe_optin GET '/probe-optin'
  WITH (timeout_sec := 30)
  AS SELECT 1 AS n;

query I
SELECT * FROM quackapi_serve(29350, host := '127.0.0.1', access_log := false,
                             read_timeout_sec := 2, write_timeout_sec := 2,
                             compression := false);
----
http://127.0.0.1:29350

# No route timeout_sec → serve-level write_timeout_sec remains effective.
query I
SELECT (http_get('http://127.0.0.1:29350/probe-default')->>'status')::INTEGER;
----
200

query I
SELECT quackapi_last_write_timeout_sec();
----
2

# Route WITH timeout_sec := 30 → ApplyRouteIoTimeout applied 30.
query I
SELECT (http_get('http://127.0.0.1:29350/probe-optin')->>'status')::INTEGER;
----
200

query I
SELECT quackapi_last_write_timeout_sec();
----
30

query I
SELECT * FROM quackapi_stop(29350);
----
Stopped quackapi server on port 29350

# --- SET quackapi_write_timeout_sec is read at serve time ----------------------
# With no named parameter the setting decides the serve-level write deadline;
# the named parameter still wins over it.
statement ok
SET quackapi_write_timeout_sec = 3;

query I
SELECT * FROM quackapi_serve(29351, host := '127.0.0.1', access_log := false, compression := false);
----
http://127.0.0.1:29351

query I
SELECT (http_get('http://127.0.0.1:29351/probe-default')->>'status')::INTEGER;
----
200

query I
SELECT quackapi_last_write_timeout_sec();
----
3

query I
SELECT * FROM quackapi_stop(29351);
----
Stopped quackapi server on port 29351

query I
SELECT * FROM quackapi_serve(29352, host := '127.0.0.1', access_log := false, compression := false,
                             write_timeout_sec := 4);
----
http://127.0.0.1:29352

query I
SELECT (http_get('http://127.0.0.1:29352/probe-default')->>'status')::INTEGER;
----
200

query I
SELECT quackapi_last_write_timeout_sec();
----
4

query I
SELECT * FROM quackapi_stop(29352);
----
Stopped quackapi server on port 29352

statement ok
RESET quackapi_write_timeout_sec;

# The live stall control/treatment (a client that sends, then waits before
# reading a 10 MB body) used quackapi_fetch(stall_ms := N), which was removed
# with quackapi_fetch; no remaining client can hold a socket unread. The
# quackapi_last_write_timeout_sec checks above still prove the apply path.
