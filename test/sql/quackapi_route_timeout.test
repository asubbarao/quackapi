# name: test/sql/quackapi_route_timeout.test
# description: Per-route TIMEOUT / WITH (timeout_sec) metadata
# group: [sql]

require quackapi

require json

# TIMEOUT clause and WITH (timeout_sec) are registered as route metadata.
query I
CREATE ROUTE slow_clause GET '/slow-clause' TIMEOUT 180 AS SELECT 1 AS n;
----
Route slow_clause: GET /slow-clause

query I
SELECT timeout_sec FROM quackapi_routes() WHERE name = 'slow_clause';
----
180

query I
CREATE OR REPLACE ROUTE slow_with GET '/slow-with'
  WITH (timeout_sec := 90)
  AS SELECT 1 AS n;
----
Route slow_with: GET /slow-with

query I
SELECT timeout_sec FROM quackapi_routes() WHERE name = 'slow_with';
----
90

query I
CREATE OR REPLACE ROUTE slow_dur GET '/slow-dur' TIMEOUT '3m' AS SELECT 1 AS n;
----
Route slow_dur: GET /slow-dur

query I
SELECT timeout_sec FROM quackapi_routes() WHERE name = 'slow_dur';
----
180

query I
CREATE ROUTE fast GET '/fast' AS SELECT 'ok' AS msg;
----
Route fast: GET /fast

query I
SELECT timeout_sec FROM quackapi_routes() WHERE name = 'fast';
----
0

statement error
CREATE ROUTE bad GET '/bad' TIMEOUT 0 AS SELECT 1;
----
timeout must be a positive

statement error
CREATE ROUTE bad2 GET '/bad2' WITH (timeout_sec := 180, response := 'json') AS SELECT 1;
----
Unknown WITH option
