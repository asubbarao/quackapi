# name: test/sql/quackapi_route_timeout.test
# description: Per-route TIMEOUT / WITH (timeout_sec) extends httplib IO deadlines
# group: [sql]

require quackapi

require json

# --- DDL: TIMEOUT clause + WITH (timeout_sec) land on the registry ------------
query I
CREATE ROUTE slow_clause GET '/slow-clause' TIMEOUT 180 AS SELECT 1 AS n;
----
Route slow_clause: GET /slow-clause

query I
SELECT timeout_sec FROM quackapi_routes() WHERE name = 'slow_clause';
----
180

query I
CREATE OR REPLACE ROUTE slow_with GET '/slow-with'
  WITH (timeout_sec := 90)
  AS SELECT 1 AS n;
----
Route slow_with: GET /slow-with

query I
SELECT timeout_sec FROM quackapi_routes() WHERE name = 'slow_with';
----
90

query I
CREATE OR REPLACE ROUTE slow_dur GET '/slow-dur' TIMEOUT '3m' AS SELECT 1 AS n;
----
Route slow_dur: GET /slow-dur

query I
SELECT timeout_sec FROM quackapi_routes() WHERE name = 'slow_dur';
----
180

# Default remains 0 (serve-level 30s IO timeouts apply).
query I
CREATE ROUTE fast GET '/fast' AS SELECT 'ok' AS msg;
----
Route fast: GET /fast

query I
SELECT timeout_sec FROM quackapi_routes() WHERE name = 'fast';
----
0

statement error
CREATE ROUTE bad GET '/bad' TIMEOUT 0 AS SELECT 1;
----
timeout must be a positive

statement error
CREATE ROUTE bad2 GET '/bad2' WITH (timeout_sec := 180, response := 'json') AS SELECT 1;
----
Unknown WITH option

# --- Effective write deadline (all platforms) --------------------------------
# Prove ApplyRouteIoTimeout ran (or did not) via quackapi_last_write_timeout_sec,
# which records what the apply path actually did — not the registry timeout_sec.

statement ok
CREATE OR REPLACE ROUTE probe_default GET '/probe-default' AS SELECT 1 AS n;

statement ok
CREATE OR REPLACE ROUTE probe_optin GET '/probe-optin'
  WITH (timeout_sec := 30)
  AS SELECT 1 AS n;

query I
SELECT * FROM quackapi_serve(29350, host := '127.0.0.1', access_log := false,
                             read_timeout_sec := 2, write_timeout_sec := 2,
                             compression := false);
----
http://127.0.0.1:29350

# No route timeout_sec → serve-level write_timeout_sec remains effective.
query I
SELECT status FROM quackapi_fetch('http://127.0.0.1:29350/probe-default');
----
200

query I
SELECT quackapi_last_write_timeout_sec();
----
2

# Route WITH timeout_sec := 30 → ApplyRouteIoTimeout applied 30.
query I
SELECT status FROM quackapi_fetch('http://127.0.0.1:29350/probe-optin');
----
200

query I
SELECT quackapi_last_write_timeout_sec();
----
30

query I
SELECT * FROM quackapi_stop(29350);
----
Stopped quackapi server on port 29350

# --- Live HTTP stall: control/treatment (POSIX only) -------------------------
# Windows receive-window autotuning absorbs the body, so client stall cannot create write backpressure.
require notwindows

# ApplyRouteIoTimeout raises httplib socket write deadlines. A compute-bound
# handler never stalls the socket, so sleep_ms cannot prove the feature.
# Observable difference: large body + client that sends then waits before
# reading (quackapi_fetch stall_ms). Serve write_timeout_sec short; stall longer.
# Control (no opt-in) truncates/fails; treatment (timeout_sec) completes.

statement ok
CREATE OR REPLACE ROUTE big_default GET '/big-default' AS
  SELECT repeat('x', 10000000) AS payload;

statement ok
CREATE OR REPLACE ROUTE big_optin GET '/big-optin'
  WITH (timeout_sec := 30)
  AS SELECT repeat('x', 10000000) AS payload;

query I
SELECT * FROM quackapi_serve(29350, host := '127.0.0.1', access_log := false,
                             read_timeout_sec := 2, write_timeout_sec := 2,
                             compression := false);
----
http://127.0.0.1:29350

# Expected complete JSON body length: [{"payload":"<10M x>"}] = 10_000_014
# Control: stall 6s > write_timeout 2s → truncated or failed (body shorter).
query I
SELECT length(body) < 10000014 AS truncated_or_short
FROM quackapi_fetch('http://127.0.0.1:29350/big-default', stall_ms := 6000);
----
true

# Treatment: per-route timeout_sec := 30 covers the stall → full body.
query I
SELECT length(body) >= 10000014 AS complete
FROM quackapi_fetch('http://127.0.0.1:29350/big-optin', stall_ms := 6000);
----
true

query I
SELECT * FROM quackapi_stop(29350);
----
Stopped quackapi server on port 29350
