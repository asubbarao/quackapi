# name: test/sql/quackapi_request_id.test
# description: X-Request-ID mint + client honor round-trip via quackapi_request
# group: [sql]

require quackapi

statement ok
CREATE OR REPLACE ROUTE echo_rid GET '/echo-rid' AS
  SELECT $request_id::VARCHAR AS id;

# Server mints: response header non-empty and matches $request_id body bind
query I
SELECT length(headers['X-Request-ID']) > 10 FROM quackapi_request('GET', '/echo-rid');
----
true

query I
SELECT decode(body) = '[{"id":"' || headers['X-Request-ID'] || '"}]'
FROM quackapi_request('GET', '/echo-rid');
----
true

# Client-supplied id honored end-to-end (header → $request_id → JSON body)
query II
SELECT status, decode(body)
FROM quackapi_request(
  'GET', '/echo-rid',
  headers := MAP {'X-Request-ID': 'client-rid-deadbeef'}
);
----
200	[{"id":"client-rid-deadbeef"}]

# Response echoes the same client id in X-Request-ID
query I
SELECT headers['X-Request-ID']
FROM quackapi_request(
  'GET', '/echo-rid',
  headers := MAP {'X-Request-ID': 'client-rid-deadbeef'}
);
----
client-rid-deadbeef

# Case-insensitive request header name
query I
SELECT decode(body)
FROM quackapi_request(
  'GET', '/echo-rid',
  headers := MAP {'X-Request-Id': 'mixed-case-id-99'}
);
----
[{"id":"mixed-case-id-99"}]
