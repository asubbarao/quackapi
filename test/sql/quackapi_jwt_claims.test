# name: test/sql/quackapi_jwt_claims.test
# description: JWT $claims_* bind / absent-NULL / reject via quackapi_request
# group: [sql]

require quackapi

require json

# Fixtures under test/sql/fixtures/ minted with SECRET 'jwt-matrix-secret' (HS256).
# Tokens with exp=4102444800 (2100-01-01) so the suite does not age out soon.
# Loaded via SET VARIABLE so signature bytes that contain '--' are not SQL comments.

query I
CREATE AUTH jwt_t AS JWT ( SECRET 'jwt-matrix-secret' );
----
Auth jwt_t: JWT_HS256

# Route that binds verified claims into handler SQL ($claims_sub / $claims_role).
query I
CREATE ROUTE me GET '/me' REQUIRE jwt_t AS
  SELECT $claims_sub AS sub, $claims_role AS role;
----
Route me: GET /me

# Absent claim must bind SQL NULL (not 422). Happy token has no 'tenant'.
query I
CREATE ROUTE me_opt GET '/me_opt' REQUIRE jwt_t AS
  SELECT $claims_sub AS sub, $claims_tenant AS tenant;
----
Route me_opt: GET /me_opt

statement ok
SET VARIABLE jwt_happy = (
  SELECT rtrim(content, E'\n\r ') FROM read_text('test/sql/fixtures/jwt_happy.txt')
);

statement ok
SET VARIABLE jwt_expired = (
  SELECT rtrim(content, E'\n\r ') FROM read_text('test/sql/fixtures/jwt_expired.txt')
);

statement ok
SET VARIABLE jwt_alg_none = (
  SELECT rtrim(content, E'\n\r ') FROM read_text('test/sql/fixtures/jwt_alg_none.txt')
);

# ---------------------------------------------------------------------------
# $claims_* binds the verified claim value into the handler SQL
# ---------------------------------------------------------------------------
query II
SELECT status, decode(body)
FROM quackapi_request(
  'GET', '/me',
  headers := MAP {'Authorization': 'Bearer ' || getvariable('jwt_happy')}
);
----
200	[{"sub":"alice","role":"admin"}]

# ---------------------------------------------------------------------------
# Absent claim binds SQL NULL — does NOT return 422
# ---------------------------------------------------------------------------
query II
SELECT status, decode(body)
FROM quackapi_request(
  'GET', '/me_opt',
  headers := MAP {'Authorization': 'Bearer ' || getvariable('jwt_happy')}
);
----
200	[{"sub":"alice","tenant":null}]

# ---------------------------------------------------------------------------
# Forged / expired rejected at request time (not merely absent from registry)
# ---------------------------------------------------------------------------
query II
SELECT status, decode(body)
FROM quackapi_request(
  'GET', '/me',
  headers := MAP {'Authorization': 'Bearer ' || getvariable('jwt_expired')}
);
----
401	{"detail":"Invalid authentication credentials"}

query II
SELECT status, decode(body)
FROM quackapi_request(
  'GET', '/me',
  headers := MAP {'Authorization': 'Bearer ' || getvariable('jwt_alg_none')}
);
----
401	{"detail":"Invalid authentication credentials"}

# No credentials → 401 (REQUIRE before bind)
query II
SELECT status, decode(body) FROM quackapi_request('GET', '/me');
----
401	{"detail":"Not authenticated"}

# ---------------------------------------------------------------------------
# Cleanup
# ---------------------------------------------------------------------------
query I
DROP ROUTE me;
----
Dropped route me

query I
DROP ROUTE me_opt;
----
Dropped route me_opt

query I
DROP AUTH jwt_t;
----
Dropped auth jwt_t
