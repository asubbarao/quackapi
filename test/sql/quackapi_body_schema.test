# name: test/sql/quackapi_body_schema.test
# description: BODY SCHEMA validation with the optional json_schema extension
# group: [sql]

require quackapi

require json

require json_schema

# Invalid schema text and an unterminated BODY SCHEMA remain DDL errors.
statement error
CREATE ROUTE invalid_schema POST '/invalid-schema'
  BODY SCHEMA '{"type":"object"'
  AS SELECT 1;
----
Invalid BODY SCHEMA JSON

statement error
CREATE ROUTE bad_schema POST '/x' BODY SCHEMA '{"type":"object" AS SELECT 1;
----
Unterminated BODY SCHEMA

# JSON Pointer numeric segments use the actual payload container: object keys
# remain JSON strings, including a leading-zero key, while array indexes are numbers.
query I
CREATE ROUTE numeric_object_key POST '/numeric-object-key'
  BODY SCHEMA '{"type":"object","properties":{"01":{"type":"integer","maximum":1}}}'
  AS SELECT 1 AS ok;
----
Route numeric_object_key: POST /numeric-object-key

query II
SELECT status, contains(decode(body), '"loc":["body","01"]')
FROM quackapi_request('POST', '/numeric-object-key', '{"01":2}');
----
422	true

query I
DROP ROUTE numeric_object_key;
----
Dropped route numeric_object_key

# Error-location parsing bounds its own JSON walk. A hostile deeply nested body
# still returns a normal 422 instead of recursing on the request stack.
query I
CREATE ROUTE deeply_nested_body POST '/deeply-nested-body'
  BODY SCHEMA '{"type":"array","items":{"type":"integer"}}'
  AS SELECT 1 AS ok;
----
Route deeply_nested_body: POST /deeply-nested-body

query I
SELECT status
FROM quackapi_request('POST', '/deeply-nested-body', repeat('[', 129) || '0' || repeat(']', 129));
----
422

query I
DROP ROUTE deeply_nested_body;
----
Dropped route deeply_nested_body

# maximum:10 is schema-only; SQL INTEGER binding alone would accept 100.
query I
CREATE ROUTE with_schema POST '/with-schema'
  BODY SCHEMA '{"type":"object","required":["n"],"properties":{"n":{"type":"integer","maximum":10}}}'
  AS SELECT $n::INTEGER AS n;
----
Route with_schema: POST /with-schema

query II
SELECT status, contains(decode(body), '"loc":["body","n"]')
FROM quackapi_request('POST', '/with-schema', '{"n":100}');
----
422	true

query I
SELECT status FROM quackapi_request('POST', '/with-schema', '{"n":"not-int"}');
----
422

query II
SELECT status, decode(body) FROM quackapi_request('POST', '/with-schema', '{"n":1}');
----
200	[{"n":1}]

query I
DROP ROUTE with_schema;
----
Dropped route with_schema
