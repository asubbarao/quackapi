# name: test/sql/quackapi_serve_defaults.test
# description: quackapi_serve() with no arguments leaves the shared DuckDB instance as it found it
# group: [sql]

require quackapi

statement ok
LOAD curl_httpfs;

statement ok
SET enable_logging = true;

# The extension load and deliberate logger state are outside the snapshot:
# curl_httpfs is a product dependency, while duckdb_settings() is caller-owned.
statement ok
CREATE TABLE settings_before AS SELECT name, value FROM duckdb_settings();

query I
SELECT * FROM quackapi_serve();
----
http://127.0.0.1:8000

query I
SELECT http_client FROM quackapi_servers() WHERE port = 8000;
----
curl

query I
SELECT contains(lower(quackapi_http_util_name()), 'curl');
----
true

query I
SELECT count(*)
FROM (
  (SELECT name, value FROM settings_before
   EXCEPT ALL
   SELECT name, value FROM duckdb_settings())
  UNION ALL
  (SELECT name, value FROM duckdb_settings()
   EXCEPT ALL
   SELECT name, value FROM settings_before)
);
----
0

# The bare stop is no longer the destructive one, but with a single server up
# there is nothing to disambiguate.
query I
SELECT * FROM quackapi_stop();
----
Stopped quackapi server on port 8000

statement ok
SET enable_logging = false;

# ---------------------------------------------------------------------------
# A named knob still moves its own setting — the opt-in is per knob.
# ---------------------------------------------------------------------------
query I
SELECT * FROM quackapi_serve(29301, host := '127.0.0.1', preserve_insertion_order := false);
----
http://127.0.0.1:29301

query I
SELECT current_setting('preserve_insertion_order');
----
false

query I
SELECT * FROM quackapi_stop(29301);
----
Stopped quackapi server on port 29301

statement ok
SET preserve_insertion_order = true;

# ---------------------------------------------------------------------------
# tune := true asks for the whole battery. curl_httpfs remains mandatory even
# when the incidental process-wide tuning is explicitly requested.
# ---------------------------------------------------------------------------
query I
SELECT * FROM quackapi_serve(29302, host := '127.0.0.1', tune := true);
----
http://127.0.0.1:29302

query I
SELECT current_setting('preserve_insertion_order');
----
false

query I
SELECT current_setting('enable_http_metadata_cache');
----
true

query I
SELECT * FROM quackapi_stop(29302);
----
Stopped quackapi server on port 29302
