# name: test/sql/quackapi_queue.test
# description: Queue delivery semantics via quackapi_request / serve+fetch
# group: [sql]

require quackapi

require json

# ---------------------------------------------------------------------------
# Setup: durable queue + HTTP routes (enqueue / claim / ack / nack / stats)
# ---------------------------------------------------------------------------
query I
CREATE QUEUE jobs WITH (max_attempts=3, visibility_timeout='1s', backoff_base_seconds=0);
----
Queue jobs: max_attempts=3 visibility_timeout=1s

statement ok
CREATE ROUTE q_enq POST '/q/enq' AS
  SELECT quackapi_enqueue('jobs', $payload::VARCHAR) AS job_id;

# $t probe defeats zero-param static JSON body cache on this branch
statement ok
CREATE ROUTE q_claim GET '/q/claim' AS
  SELECT id, payload, status, attempts FROM quackapi_dequeue('jobs', 1)
  WHERE $t::INT >= 0;

statement ok
CREATE ROUTE q_ack POST '/q/ack' AS
  SELECT quackapi_ack('jobs', $id::BIGINT) AS ok;

statement ok
CREATE ROUTE q_nack POST '/q/nack' AS
  SELECT quackapi_nack('jobs', $id::BIGINT, $requeue::BOOLEAN, $error::VARCHAR) AS status;

statement ok
CREATE ROUTE q_stats GET '/q/stats' AS
  SELECT name, depth, in_flight, dead FROM quackapi_queues()
  WHERE name = 'jobs' AND $t::INT >= 0;

# ---------------------------------------------------------------------------
# HTTP enqueue → depth; claim leases; second claim empty (visibility hold)
# ---------------------------------------------------------------------------
query II
SELECT status, decode(body) FROM quackapi_request('POST', '/q/enq', '{"payload":"{\"task\":\"a\"}"}');
----
200	[{"job_id":1}]

query I
SELECT decode(body) FROM quackapi_request('GET', '/q/stats?t=1');
----
[{"name":"jobs","depth":1,"in_flight":0,"dead":0}]

query II
SELECT status,
       json_extract(decode(body)::JSON, '$[0].id')::BIGINT AS id
FROM quackapi_request('GET', '/q/claim?t=1');
----
200	1

# Leased — invisible to a second dequeue
query I
SELECT decode(body) FROM quackapi_request('GET', '/q/claim?t=2');
----
[]

query I
SELECT decode(body) FROM quackapi_request('GET', '/q/stats?t=2');
----
[{"name":"jobs","depth":0,"in_flight":1,"dead":0}]

# Visibility timeout lapses → redelivery (attempts increment)
statement ok
SELECT sleep_ms(1100);

query III
SELECT status,
       json_extract(decode(body)::JSON, '$[0].id')::BIGINT,
       json_extract(decode(body)::JSON, '$[0].attempts')::INTEGER
FROM quackapi_request('GET', '/q/claim?t=3');
----
200	1	2

# ---------------------------------------------------------------------------
# ack removes permanently — no redelivery after visibility would have lapsed
# ---------------------------------------------------------------------------
query II
SELECT status, decode(body) FROM quackapi_request('POST', '/q/ack', '{"id":1}');
----
200	[{"ok":true}]

query I
SELECT decode(body) FROM quackapi_request('GET', '/q/claim?t=4');
----
[]

statement ok
SELECT sleep_ms(1100);

query I
SELECT decode(body) FROM quackapi_request('GET', '/q/claim?t=5');
----
[]

query I
SELECT decode(body) FROM quackapi_request('GET', '/q/stats?t=3');
----
[{"name":"jobs","depth":0,"in_flight":0,"dead":0}]

# ---------------------------------------------------------------------------
# nack returns the message for redelivery
# ---------------------------------------------------------------------------
query II
SELECT status, decode(body) FROM quackapi_request('POST', '/q/enq', '{"payload":"{\"task\":\"b\"}"}');
----
200	[{"job_id":2}]

query I
SELECT json_extract(decode(body)::JSON, '$[0].id')::BIGINT FROM quackapi_request('GET', '/q/claim?t=6');
----
2

query II
SELECT status, decode(body)
FROM quackapi_request('POST', '/q/nack', '{"id":2,"requeue":true,"error":"try_again"}');
----
200	[{"status":"pending"}]

query III
SELECT status,
       json_extract(decode(body)::JSON, '$[0].id')::BIGINT,
       json_extract(decode(body)::JSON, '$[0].attempts')::INTEGER
FROM quackapi_request('GET', '/q/claim?t=7');
----
200	2	2

# nack without requeue → dead; not redelivered
query II
SELECT status, decode(body)
FROM quackapi_request('POST', '/q/nack', '{"id":2,"requeue":false,"error":"no_retry"}');
----
200	[{"status":"dead"}]

query I
SELECT decode(body) FROM quackapi_request('GET', '/q/claim?t=8');
----
[]

query I
SELECT decode(body) FROM quackapi_request('GET', '/q/stats?t=4');
----
[{"name":"jobs","depth":0,"in_flight":0,"dead":1}]

# ---------------------------------------------------------------------------
# Concurrent dequeue: one message → exactly one winner across parallel GETs
#
# Uses its own queue with a visibility timeout far longer than the storm can
# take. The `jobs` queue above is deliberately 1s so the tests before this one
# can exercise lease lapse + redelivery — but redelivery after an expired lease
# is CORRECT queue behavior, so reusing `jobs` here made this test assert
# "the 8-request storm finishes within 1s", a wall-clock property CI cannot
# guarantee. On a loaded runner the lease lapsed mid-storm and a second
# claimant legitimately won job 3 (attempts 1 then 2 -> winner_ids [3,3]).
# A long lease isolates the property actually under test: exclusive claim.
# ---------------------------------------------------------------------------
query I
CREATE QUEUE race WITH (max_attempts=3, visibility_timeout='300s', backoff_base_seconds=0);
----
Queue race: max_attempts=3 visibility_timeout=300s

statement ok
CREATE ROUTE q_rclaim GET '/q/rclaim' AS
  SELECT id, payload, status, attempts FROM quackapi_dequeue('race', 1)
  WHERE $t::INT >= 0;

statement ok
CREATE ROUTE q_renq POST '/q/renq' AS
  SELECT quackapi_enqueue('race', $payload::VARCHAR) AS job_id;

query II
SELECT status, decode(body) FROM quackapi_request('POST', '/q/renq', '{"payload":"{\"task\":\"race\"}"}');
----
200	[{"job_id":3}]

query I
SELECT * FROM quackapi_serve(29270, host := '127.0.0.1', access_log := false, worker_threads := 8);
----
http://127.0.0.1:29270

# Exactly one winner with job 3; losers empty []; every attempt 200 with no error.
query III
SELECT list(json_extract(body::JSON, '$[0].id')::BIGINT)
         FILTER (WHERE status = 200 AND body != '[]') AS winner_ids,
       bool_and(status = 200 AND error IS NULL) AS all_ok,
       len(list(idx) FILTER (WHERE body = '[]')) AS empty_n
FROM quackapi_parallel_fetch('http://127.0.0.1:29270/q/rclaim?t=9', 8);
----
[3]	true	7

query I
SELECT * FROM quackapi_stop(29270);
----
Stopped quackapi server on port 29270
