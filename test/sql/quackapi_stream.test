# name: test/sql/quackapi_stream.test
# description: CREATE STREAM SSE emission over real serve + http_request
# group: [sql]

require quackapi

require http_request

statement ok
SET http_request_cache = false;

# Test-local adapter: keep body assertions textual while using the standard HTTP extension.
statement ok
CREATE MACRO test_http_get(u, h := MAP{}) AS (SELECT {'status': r.status, 'body': decode(r.body), 'headers': r.headers} FROM (SELECT http_get(u, h) AS r));

statement ok
CREATE MACRO test_http_get_table(u, h := MAP{}) AS TABLE SELECT r.* FROM (SELECT test_http_get(u, h) AS r);


# Finite one-shot stream (interval=0 closes after rows)
query I
CREATE STREAM ticks GET '/ticks' AS SELECT i AS id, 'tick' AS msg FROM range(3) t(i);
----
Stream ticks: GET /ticks SSE

# WebSocket streams register like SSE ones (frames are tested in test/cpp/quackapi_websocket_test.cpp)
query I
CREATE STREAM chat WS '/ws' AS SELECT upper($message) AS reply;
----
Stream chat: WS /ws WS

query I
CREATE STREAM feed WEBSOCKET '/feed' WITH (interval='250ms') AS SELECT 1 AS n;
----
Stream feed: WS /feed WS interval=250ms

query IIII
SELECT name, method, transport, interval_ms FROM quackapi_streams() ORDER BY name;
----
chat	WS	ws	0
feed	WS	ws	250
ticks	GET	sse	0

# wss:// is the client's TLS, not a different stream
statement error
CREATE STREAM secure WSS '/secure' AS SELECT 1;
----
Use WS

statement error
CREATE STREAM bad POST '/bad' AS SELECT 1;
----
GET (Server-Sent Events) or WS (WebSocket)

# A plain HTTP request to a WS path asks for the upgrade
query II
SELECT status, headers['Upgrade'] FROM quackapi_request('GET', '/ws');
----
426	websocket

# Path must start with /
statement error
CREATE STREAM bad GET 'nope' AS SELECT 1;
----
must start with '/'

# In-process path sets SSE content-type (chunked body drained by TCP clients)
query II
SELECT status, content_type FROM quackapi_request('GET', '/ticks');
----
200	text/event-stream

query I
SELECT headers['X-Request-ID'] IS NOT NULL FROM quackapi_request('GET', '/ticks');
----
true

# Real serve: body is Server-Sent Events (id + data lines)
query I
SELECT * FROM quackapi_serve(29260, host := '127.0.0.1', access_log := false);
----
http://127.0.0.1:29260

query III
SELECT r.status,
       r.headers['Content-Type'],
       starts_with(r.body, 'id: 0')
         AND contains(r.body, 'data: {"id":0,"msg":"tick"}')
         AND contains(r.body, 'data: {"id":1,"msg":"tick"}')
         AND contains(r.body, 'data: {"id":2,"msg":"tick"}')
FROM (SELECT test_http_get('http://127.0.0.1:29260/ticks') AS r);
----
200	text/event-stream	true

query I
SELECT * FROM quackapi_stop(29260);
----
Stopped quackapi server on port 29260

query I
DROP STREAM ticks;
----
Dropped stream ticks

query I
DROP STREAM chat;
----
Dropped stream chat

query I
DROP STREAM feed;
----
Dropped stream feed
