# name: test/sql/quackapi_stream.test
# description: CREATE STREAM SSE emission over real serve, read with http_client
# group: [sql]

require quackapi

require json

# Community http_client is the TCP client for these tests (http_get / http_head).
statement ok
INSTALL http_client FROM community;

statement ok
LOAD http_client;

# Finite one-shot stream (interval=0 closes after rows)
query I
CREATE STREAM ticks GET '/ticks' AS SELECT i AS id, 'tick' AS msg FROM range(3) t(i);
----
Stream ticks: GET /ticks SSE

# WebSocket method is rejected (httplib has no WS server)
statement error
CREATE STREAM chat WS '/ws' AS SELECT 1;
----
WebSocket is not supported

# Path must start with /
statement error
CREATE STREAM bad GET 'nope' AS SELECT 1;
----
must start with '/'

# In-process path sets SSE content-type (chunked body drained by TCP clients)
query II
SELECT status, content_type FROM quackapi_request('GET', '/ticks');
----
200	text/event-stream

# Real serve: body is Server-Sent Events (id + data lines)
query I
SELECT * FROM quackapi_serve(29260, host := '127.0.0.1', access_log := false);
----
http://127.0.0.1:29260

# http_get returns status + body; http_head returns the response headers.
query III
SELECT (g->>'status')::INTEGER,
       (h->>'headers')::JSON->>'content-type',
       starts_with(g->>'body', 'id: 0')
         AND contains(g->>'body', 'data: {"id":0,"msg":"tick"}')
         AND contains(g->>'body', 'data: {"id":1,"msg":"tick"}')
         AND contains(g->>'body', 'data: {"id":2,"msg":"tick"}')
FROM (SELECT http_get('http://127.0.0.1:29260/ticks') AS g, http_head('http://127.0.0.1:29260/ticks') AS h);
----
200	text/event-stream	true

query I
SELECT * FROM quackapi_stop(29260);
----
Stopped quackapi server on port 29260

query I
DROP STREAM ticks;
----
Dropped stream ticks
