# name: test/sql/quackapi_queue_volatile.test
# description: Queue mutation scalar volatility and prepared execution semantics
# group: [sql]

require quackapi

require json

# Every queue-mutating scalar overload must be VOLATILE, including all arities.
query I
SELECT bool_and(stability = 'VOLATILE')
       AND count(*) = 9
       AND count(*) FILTER (WHERE function_name = 'quackapi_enqueue') = 4
       AND count(*) FILTER (WHERE function_name = 'quackapi_ack') = 1
       AND count(*) FILTER (WHERE function_name = 'quackapi_nack') = 3
       AND count(*) FILTER (WHERE function_name = 'quackapi_renew') = 1
FROM duckdb_functions()
WHERE function_name IN ('quackapi_enqueue', 'quackapi_ack', 'quackapi_nack', 'quackapi_renew');
----
true

query I
CREATE QUEUE prepared_enqueue WITH (max_attempts=3, visibility_timeout='300s', backoff_base_seconds=0);
----
Queue prepared_enqueue: max_attempts=3 visibility_timeout=300s

# PREPARE must plan only; it must not enqueue a job.
statement ok
PREPARE prepared_enqueue_stmt AS
  SELECT quackapi_enqueue('prepared_enqueue', '{"task":"prepared"}');

query I
SELECT count(*) FROM quackapi_jobs WHERE queue = 'prepared_enqueue';
----
0

# Each EXECUTE must invoke the mutation again rather than reuse a folded result.
statement ok
EXECUTE prepared_enqueue_stmt;

query I
SELECT count(*) FROM quackapi_jobs WHERE queue = 'prepared_enqueue';
----
1

statement ok
EXECUTE prepared_enqueue_stmt;

query I
SELECT count(*) FROM quackapi_jobs WHERE queue = 'prepared_enqueue';
----
2

statement ok
DEALLOCATE prepared_enqueue_stmt;
