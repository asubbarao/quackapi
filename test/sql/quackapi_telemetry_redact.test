# name: test/sql/quackapi_telemetry_redact.test
# description: Opt-in access-log header and query redaction
# group: [sql]

require quackapi

statement ok
CREATE TABLE redaction_log (
  path VARCHAR,
  status INTEGER,
  headers MAP(VARCHAR, VARCHAR),
  query VARCHAR
);

statement ok
CREATE OR REPLACE ROUTE redaction_route GET '/redaction' AS
  SELECT 'ok' AS result;

query I
SELECT status
FROM quackapi_request(
  'GET',
  '/redaction',
  headers := MAP {
    'Authorization': 'Bearer do-not-store',
    'X-Tenant-ID': 'tenant-42',
    'X-Not-Logged': 'omit-me'
  },
  access_log := 'redaction_log',
  log_headers := ' authorization, X-TENANT-ID '
);
----
200

query III
SELECT headers['authorization'], headers['x-tenant-id'], headers['x-not-logged'] IS NULL
FROM redaction_log
WHERE path = '/redaction';
----
[REDACTED]	tenant-42	true

query I
SELECT status
FROM quackapi_request(
  'GET',
  '/redaction?token=abc&q=x',
  access_log := 'redaction_log',
  log_query := true
);
----
200

query I
SELECT query
FROM redaction_log
WHERE query IS NOT NULL;
----
token=[REDACTED]&q=x

query I
SELECT status
FROM quackapi_request(
  'GET',
  '/redaction?token=abc&q=x',
  headers := MAP {'X-Tenant-ID': 'tenant-42'},
  access_log := 'redaction_log'
);
----
200

query II
SELECT query IS NULL, headers IS NULL
FROM redaction_log
WHERE query IS NULL AND headers IS NULL;
----
true	true
