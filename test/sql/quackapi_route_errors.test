# name: test/sql/quackapi_route_errors.test
# description: Route execution errors preserve DuckDB diagnostics
# group: [sql]

require quackapi

query I
CREATE OR REPLACE ROUTE sql POST '/sql' AS SELECT * FROM query($sql);
----
Route sql: POST /sql

query II
SELECT status,
       contains(decode(body), 'Conversion Error') AND
       contains(decode(body), 'nope')
FROM quackapi_request('POST', '/sql', '{"sql":"SELECT CAST(''nope'' AS INTEGER)"}');
----
422	true

query II
SELECT status,
       contains(decode(body), 'nowhere') AND
       contains(decode(body), 'Table with name')
FROM quackapi_request('POST', '/sql', '{"sql":"SELECT nope FROM nowhere"}');
----
500	true

query I
CREATE TABLE quackapi_sql_empty (x INTEGER);
----

# Dynamic SQL is validated before delegation so parser errors cannot become 200 []
query II
SELECT status, contains(decode(body), 'SELEC')
FROM quackapi_request('POST', '/sql', '{"sql":"SELEC 1"}');
----
422	true

# Valid SELECT response shape is unchanged.
query II
SELECT status, decode(body)
FROM quackapi_request('POST', '/sql', '{"sql":"SELECT 42 AS answer"}');
----
200	[{"answer":42}]

# A valid statement with no rows remains 200 [].
query II
SELECT status, decode(body)
FROM quackapi_request('POST', '/sql', '{"sql":"SELECT * FROM quackapi_sql_empty"}');
----
200	[]

query I
DROP TABLE quackapi_sql_empty;
----

# error() in a handler is a handler bug → 500, not 422 with a fabricated location.
query I
CREATE OR REPLACE ROUTE thrower GET '/thrower' AS SELECT error('kaboom-custom-msg') AS x;
----
Route thrower: GET /thrower

query II
SELECT status, contains(decode(body), 'kaboom-custom-msg') FROM quackapi_request('GET', '/thrower');
----
500	true

query I
DROP ROUTE thrower;
----
Dropped route thrower

query I
DROP ROUTE sql;
----
Dropped route sql
