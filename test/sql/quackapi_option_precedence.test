# name: test/sql/quackapi_option_precedence.test
# description: Named request options override settings across positional overloads
# group: [sql]

require quackapi

statement ok
SET quackapi_max_response_bytes = 64;

statement ok
CREATE ROUTE option_precedence_payload GET '/option-precedence-payload' AS SELECT repeat('x', 128) AS payload;

query I
SELECT status FROM quackapi_request('GET', '/option-precedence-payload');
----
507

query I
SELECT status FROM quackapi_request('GET', '/option-precedence-payload', max_response_bytes := 256);
----
200

query I
SELECT status FROM quackapi_request('GET', '/option-precedence-payload', '', max_response_bytes := 256);
----
200

statement error
SELECT status FROM quackapi_request('GET', '/option-precedence-payload', max_response_bytes := NULL);
----
max_response_bytes must not be NULL

statement ok
RESET quackapi_max_response_bytes;
