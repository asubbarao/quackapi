# name: test/sql/quackapi_bind_validation.test
# description: serve/stop reject unknown option values at bind instead of falling back
# group: [sql]

require quackapi

# A value that quietly became a default left no way to tell from the server's
# behaviour which bucket it landed in. Each of these is a literal in the
# statement, so bind is where it is answerable.

statement error
SELECT * FROM quackapi_serve(29401, host := '127.0.0.1', log_level := 'bogus');
----
log_level must be one of [silent, off, none, error, warn, warning, info, debug, trace, verbose]

statement error
SELECT * FROM quackapi_serve(29402, host := '127.0.0.1', log_level := 'infoo');
----
log_level must be one of [silent, off, none, error, warn, warning, info, debug, trace, verbose]

statement ok
SET quackapi_log_level = 'bogus';

# The setting is read at bind too, so a typo there fails the same way.
statement error
SELECT * FROM quackapi_serve(29403, host := '127.0.0.1');
----
log_level must be one of [silent, off, none, error, warn, warning, info, debug, trace, verbose]

statement ok
SET quackapi_log_level = 'info';

# http_client cannot choose an implementation. The compatibility spelling
# accepts only curl, so the old stock client spelling must fail closed.
statement error
SELECT * FROM quackapi_serve(29404, host := '127.0.0.1', http_client := 'httplib');
----
http_client must be one of [curl], not 'httplib'

# Invalid DDL must name the complete domain instead of quietly selecting the
# default representation or request source.
statement error
CREATE ROUTE bad_format GET '/bad-format' FORMAT yaml AS SELECT 1;
----
FORMAT must be one of [json, ndjson, csv, parquet, arrow], not 'yaml'

statement error
CREATE ROUTE bad_envelope GET '/bad-envelope' ENVELOPE scalar AS SELECT 1;
----
ENVELOPE must be one of [array, object], not 'scalar'

statement error
CREATE ROUTE bad_source GET '/bad-source' PARAM p VARCHAR FORM AS SELECT 1;
----
valid sources are [query, header, cookie]

# ---------------------------------------------------------------------------
# quackapi_stop() with no port: never a silent teardown of servers this caller
# did not start.
# ---------------------------------------------------------------------------
query I
SELECT * FROM quackapi_stop();
----
No quackapi servers running

query I
SELECT * FROM quackapi_serve(29406, host := '127.0.0.1');
----
http://127.0.0.1:29406

query I
SELECT * FROM quackapi_serve(29407, host := '127.0.0.1');
----
http://127.0.0.1:29407

statement error
SELECT * FROM quackapi_stop();
----
2 servers are running

statement error
SELECT * FROM quackapi_stop(29406, all_servers := true);
----
pass a port or all_servers := true

query I
SELECT * FROM quackapi_stop(all_servers := true);
----
Stopped all quackapi servers
