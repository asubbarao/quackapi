# name: test/sql/quackapi_pg_prepare_cache.test
# description: PostgreSQL access through DuckDB's postgres extension
# group: [sql]

require quackapi

require-env QUACKAPI_TEST_PG_DSN

statement ok
INSTALL postgres;

statement ok
LOAD postgres;

statement ok
ATTACH '${QUACKAPI_TEST_PG_DSN}' AS qa_pg (TYPE postgres);

statement ok
CALL postgres_execute('qa_pg', 'CREATE TABLE IF NOT EXISTS qa_quackapi_items (id INTEGER PRIMARY KEY, owner TEXT NOT NULL)');

statement ok
CALL postgres_execute('qa_pg', 'DELETE FROM qa_quackapi_items');

statement ok
INSERT INTO qa_pg.public.qa_quackapi_items VALUES (1, 'alice'), (2, 'bob');

statement ok
CREATE AUTH qa_pg_auth AS API_KEY;

statement ok
SELECT * FROM quackapi_add_api_key('qa_pg_auth', 'qa-secret', 'alice');

statement ok
CREATE ROUTE qa_pg_item GET '/qa-pg/:id' REQUIRE qa_pg_auth PARAM id INTEGER GE 1 AS SELECT id, owner FROM qa_pg.public.qa_quackapi_items WHERE id = $id AND owner = $claims_sub;

query II
SELECT status, decode(body) FROM quackapi_request('GET', '/qa-pg/1?claims_sub=bob', headers := MAP {'X-API-Key': 'qa-secret'});
----
200	[{"id":1,"owner":"alice"}]

query II
SELECT status, decode(body) FROM quackapi_request('GET', '/qa-pg/2?claims_sub=bob', headers := MAP {'X-API-Key': 'qa-secret'});
----
200	[]

query I
SELECT status FROM quackapi_request('GET', '/qa-pg/0', headers := MAP {'X-API-Key': 'qa-secret'});
----
422

statement ok
CALL postgres_execute('qa_pg', 'DROP TABLE qa_quackapi_items');
